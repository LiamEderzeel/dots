
# Aliases
alias git-clean="git fetch --prune origin && git branch --merged main | grep -v -E '^[*+]|^\s*(main|master|dev)$' | xargs -r git branch -d"
alias configlg='lazygit --work-tree ~ --git-dir ~/.dots'
alias config='git --git-dir=$HOME/.dots/ --work-tree=$HOME'
alias tmux="env TERM=xterm-256color tmux"
alias v='nvim'
alias lv='(){(export NVIM_APPNAME=lv;export MYVIMRC=~/.config/lazyvim/init.lua;nvim)}'
alias lvim='~/.local/bin/lvim '
alias work='cd ~/projects'
alias lg='lazygit'
alias ld='lazydocker'
alias mk="minikube kubectl --"
alias k="kubectl"
alias m='minikube'
alias d='docker'
alias dc='docker compose'
alias sudo='sudo '
alias df='dysk '
# alias p='tmux-booster -d ~/projects/personal -d ~/projects/whas -d ~/projects/hot -d ~/projects/personal/valideer'
alias safe-claude='docker run -it --rm --user "$(id -u):$(id -g)" -e HOME=/home/node -v "$(pwd):/workspace" -v "$HOME/.claude:/home/node/.claude" -v "$HOME/.claude.json:/home/node/.claude.json" -w /workspace node:22 npx -y @anthropic-ai/claude-code'

alias p='tmux-booster -d ~/projects/personal -d ~/projects/whas -d ~/projects/hot -d ~/projects/hoph -p ~/.nixos -p ~/Documents/obsidian'

if [ "$TERM" = "xterm-kitty" ]; then
  alias ssh="kitty +kitten ssh"
fi
